#!/bin/sh
# Pre-commit hook: the site's root files are generated by tools/build_all.py, and Vercel
# deploys them as they are (no build step on Vercel). This hook rebuilds, runs the SEO
# checks, and blocks the commit if a check fails or if the rebuilt files differ from
# what is being committed (meaning someone edited tools/ without rebuilding, or edited
# a generated file by hand).
#
# Enabled once per clone with:   git config core.hooksPath tools/hooks
# Skip in an emergency with:     git commit --no-verify

cd "$(git rev-parse --show-toplevel)" || exit 1

GENERATED='*.html blog/*.html assets/styles.css assets/main.js sitemap.xml robots.txt llms.txt llms-full.txt site.webmanifest vercel.json tools/lastmod.json'

# Only run when the commit touches the generator or a generated file (docs-only commits skip it).
staged=$(git diff --cached --name-only --diff-filter=ACMRD)
relevant=0
for f in $staged; do
  case "$f" in
    tools/*.py|tools/*.css|tools/*.js|tools/*.svg|tools/*.snippet) relevant=1 ;;
    *.html|blog/*.html|assets/*|sitemap.xml|robots.txt|llms.txt|llms-full.txt|site.webmanifest|vercel.json) relevant=1 ;;
  esac
done
[ "$relevant" = 0 ] && exit 0

echo "pre-commit: rebuilding the site (tools/build_all.py)..."
if ! python3 tools/build_all.py > /dev/null; then
  echo "pre-commit: BUILD FAILED. Fix the error above before committing." >&2
  exit 1
fi

out=$(python3 tools/verify.py)
if ! printf '%s\n' "$out" | grep -q 'ALL CHECKS PASSED'; then
  printf '%s\n' "$out" >&2
  echo "pre-commit: verify.py found problems (listed above). Commit blocked." >&2
  exit 1
fi

# Rebuilt output must match the index: anything changed or new means the commit is stale.
# shellcheck disable=SC2086
stale=$(git diff --name-only -- $GENERATED; git ls-files --others --exclude-standard -- $GENERATED)
if [ -n "$stale" ]; then
  echo "pre-commit: these generated files changed when rebuilt and are not staged:" >&2
  printf '  %s\n' $stale >&2
  echo "Review them, stage them (git add <files>) and commit again." >&2
  echo "Never edit generated files by hand: edit tools/ instead (see tools/README.md)." >&2
  exit 1
fi

echo "pre-commit: build up to date, all checks passed."
exit 0
